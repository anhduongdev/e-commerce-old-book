# Dùng cho docker-compose.prod.yml ở VPS.
# Copy thành `.env` (cùng thư mục với docker-compose.prod.yml), điền giá trị thật,
# KHÔNG commit file `.env`.

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=comic_store
MYSQL_USER=comic_user
MYSQL_PASSWORD=change_me_password

# URL public mà TRÌNH DUYỆT gọi tới backend — phải trùng domain đã trỏ DNS
# và đã tạo Proxy Host + SSL trong Nginx Proxy Manager.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
